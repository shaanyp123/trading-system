# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.Python
.venv/
venv/
env/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Futures research harness (research/) — local artifacts, never source.
research/runs/*
!research/runs/.gitignore
research/data/cache/
coverage.xml
*.cover

# Node / Next.js
node_modules/
.next/
.pnpm-debug.log
.npm/
.yarn/
.turbo/

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Local env files (NEVER commit)
.env
.env.local
.env.*.local

# Secrets — the host secrets file lives OUTSIDE the repo
# (/opt/trading-secrets/secrets.yaml per deploy/secrets.template.yaml;
# sops retired 2026-07-09). Block any filled copy from a careless
# `git add -A` anyway. The committed template is allowlisted.
secrets.yaml
secrets-decrypted/
!deploy/secrets.template.yaml

# Build artifacts
*.log
*.tmp
*.bak

# Local SQLite (dev)
*.db
*.sqlite
*.sqlite3

# Operator handoff prompts (session-local; not for the repo)
HANDOFF_PROMPT_*.md

# Claude Code session-local working dir (worktrees, transient session state).
# Updated 2026-05-25 via claude-setup-overhaul WS#4+WS#3+WS#5: project-level
# hooks, commands, agents, skills, and shared settings.json should be in the
# repo so future sessions / future contributors inherit them. Personal /
# operator-local config stays gitignored.
.claude/*
!.claude/settings.json
!.claude/README.md
!.claude/hooks/
!.claude/commands/
!.claude/agents/
!.claude/skills/
