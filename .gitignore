# Secrets — only sops-encrypted files are allowed in `secrets/`
# (see secrets/.gitignore for the inverted rule)

# VPS-side sops-decrypted plaintext volume (e.g. /opt/trading/secrets-decrypted/)
# Created by deploy/day5-bringup.sh; canonical pattern, NOT a leak. But blocking
# at the repo root prevents a careless `git add -A` on the VPS from committing
# plaintext credentials. See Day 11 carryover follow-up.
secrets-decrypted/

# Build artifacts
*.log
*.tmp
*.bak

# Local SQLite (dev)
*.db
*.sqlite
*.sqlite3

# Operator handoff prompts (session-local; not for the repo)
HANDOFF_PROMPT_*.md

# Claude Code session-local working dir (worktrees, transient session state)
# The user's global ~/.config/git/ignore covers **/.claude/settings.local.json,
# but the directory itself is not globally ignored. Keep session-local junk
# out of the repo.
.claude/
