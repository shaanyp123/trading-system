.turbo/

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Local env files (NEVER commit)
.env
.env.local
.env.*.local

# Secrets — only sops-encrypted files are allowed in `secrets/`
# (see secrets/.gitignore for the inverted rule)

# VPS-side sops-decrypted plaintext volume (e.g. /opt/trading/secrets-decrypted/)
# Created by deploy/day5-bringup.sh; canonical pattern, NOT a leak. But blocking
# at the repo root prevents a careless `git add -A` on the VPS from committing
# plaintext credentials. See Day 11 carryover follow-up.
secrets-decrypted/

# Build artifacts
*.log
*.tmp
*.bak

# Local SQLite (dev)
*.db
*.sqlite
*.sqlite3

# Operator handoff prompts (session-local; not for the repo)
HANDOFF_PROMPT_*.md

# Claude Code session-local working dir (worktrees, transient session state).
# Updated 2026-05-25 via claude-setup-overhaul WS#4+WS#3+WS#5: project-level
# hooks, commands, agents, skills, and shared settings.json should be in the
# repo so future sessions / future contributors inherit them. Personal /
# operator-local config stays gitignored.
.claude/*
!.claude/settings.json
!.claude/README.md
!.claude/hooks/
!.claude/commands/
!.claude/agents/
!.claude/skills/
