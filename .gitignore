*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.Python
.venv/
venv/
env/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Futures research harness (research/) — local artifacts, never source.
research/runs/*
!research/runs/.gitignore
research/data/cache/
coverage.xml
*.cover

