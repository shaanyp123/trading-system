[Unit]
Description=Run Trading System external watchdog every 5 minutes
Documentation=https://github.com/shaanyp123/trading-system/blob/main/watchdog/README.md
Requires=trading-watchdog.service

[Timer]
# OnBootSec: first check fires 1 minute after boot — gives network time to
# come up and avoids a false-positive on every reboot.
OnBootSec=1min

# OnUnitActiveSec: every 5 minutes after the last service activation.
# Backend-spec §1.6 cadence: "5-min cron". 3 consecutive failures ≈ 15 min
# unreachable before the alert fires.
OnUnitActiveSec=5min

# RandomizedDelaySec: smear timer firing across 0-30s. Avoids the watchdog
# always landing on the same wall-clock second, which would synchronize with
# any periodic backend job and bias the failure-detection rate.
RandomizedDelaySec=30s

# Persistent: if the system was off when a fire was scheduled, run as soon as
# it's back. (Realistic on a VPS this isn't a concern, but it costs nothing.)
Persistent=true

Unit=trading-watchdog.service

[Install]
WantedBy=timers.target
