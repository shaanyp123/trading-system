# Template for `deploy/.env` on the VPS.
# Copy to `.env` (gitignored) and fill in per environment.
# Anti-pattern A11: never commit a populated `.env`. gitleaks blocks it on push.

# GHCR image namespace (locked: shaanyp123)
GHCR_OWNER=shaanyp123

# Release SHA (set by deploy hook; defaults to `latest` for local up).
RELEASE_SHA=latest

# Audit env tag — matches `audit_log.env` CHECK constraint.
# One of: dev | paper | live-small | live-scale
ENVIRONMENT=paper

# Caddy auto-cert + apex domain.
DOMAIN=spratcapital.com
ACME_EMAIL=shaanrpatel2@gmail.com

# Caddy IP allowlist for /api/internal/watchdog (Hetzner Nuremberg static IP).
WATCHDOG_IP=188.245.37.16

# Environment file used by sops_init at compose start.
# One of: dev.enc.yaml | paper.enc.yaml | live.enc.yaml
ENV_FILE=paper.enc.yaml

# Path to age private key on the VPS (systemd LoadCredentialEncrypted exposes this).
SOPS_AGE_KEY_FILE=/etc/credstore.encrypted/age_key

# Postgres superuser bootstrap (one-time generated; rotate annually).
# Generate via `openssl rand -hex 32`. The app-level role passwords
# (app_service, app_owner) live in secrets/<env>.enc.yaml, NOT here.
POSTGRES_SUPERUSER_PASSWORD=<openssl-rand-hex-32>

# Optional api log verbosity.
API_LOG_LEVEL=INFO

# LEAN Local live-mode toggle.
# - false (default; behaves the same as unset) → LEAN runs the `backtesting`
#   environment from `lean/lean.json`.
# - true → LEAN runs the `paper-internal` environment (PaperBrokerage
#   simulator + FakeDataQueue + SubscriptionDataReaderHistoryProvider).
#   The strategy generates daily 17:30 ET signals and POSTs them to the
#   api at /api/internal/lean/signals.
# Post-ceremony 2026-05-12: no IBKR credentials needed on the LEAN side.
# See `deploy/lean_local/README.md` for the full runbook.
# LEAN_LIVE_MODE=true
