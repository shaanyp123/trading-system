# Template for `deploy/.env` on the VPS.
# Copy to `.env` (gitignored) and fill in per environment.
# Anti-pattern A11: never commit a populated `.env`. gitleaks blocks it on push.

# GHCR image namespace (locked: shaanyp123)
GHCR_OWNER=shaanyp123

# Release SHA (set by deploy hook; defaults to `latest` for local up).
RELEASE_SHA=latest

# Audit env tag — matches `audit_log.env` CHECK constraint.
# One of: dev | paper | live-small | live-scale
ENVIRONMENT=paper

# Caddy auto-cert + apex domain.
DOMAIN=spratcapital.com
ACME_EMAIL=shaanrpatel2@gmail.com

# Caddy IP allowlist for /api/internal/watchdog (Hetzner Nuremberg static IP).
WATCHDOG_IP=188.245.37.16

# Host directory holding the plain-YAML secrets file (secrets.yaml),
# bind-mounted read-only into containers at /run/secrets.
# Authored by hand from deploy/secrets.template.yaml — root-owned,
# chown 1000:1000 + chmod 0400 by deploy/day5-bringup.sh.
# (Crypto-pivot 2026-07-09: replaces the retired sops/age pipeline —
# see Docs/decisions-log.md.)
SECRETS_DIR=/opt/trading-secrets

# Postgres superuser bootstrap (one-time generated; rotate annually).
# Generate via `openssl rand -hex 32`. The app-level role passwords
# (app_service, app_owner) live in ${SECRETS_DIR}/secrets.yaml, NOT here.
POSTGRES_SUPERUSER_PASSWORD=<openssl-rand-hex-32>

# Optional api log verbosity.
API_LOG_LEVEL=INFO

# Crypto-pivot C0-B2b (2026-07-09): the IBKR clientId / Master Client ID
# knobs and the LEAN live-mode toggle that lived here died with the
# IBKR/LEAN stack. Coinbase execution credentials live in the secrets
# file (coinbase.api_key_name / coinbase.api_private_key), not .env knobs.
