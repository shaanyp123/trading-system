# Caddyfile — Hetzner Ashburn primary VPS reverse proxy.
#
# - Auto-cert via Let's Encrypt (HTTP-01 / TLS-ALPN). Requires DNS A record +
#   ports 80/443 open.
# - Anti-pattern A18: no bare `<your-domain>` or `<watchdog_static_ip>`;
#   substituted at deploy time via Caddy's env-var support (`{$VAR}`). The
#   docker-compose `caddy` service exports DOMAIN, ACME_EMAIL, WATCHDOG_IP
#   from `deploy/.env` per backend-spec §9.2.1.
{
	email {$ACME_EMAIL}
	servers {
		# DP-003 (Day 17, 2026-05-10) — Caddy's `write` timeout caps the time to
		# write the entire response, NOT the per-write window. SSE responses are
		# infinite, so a 30s write cap closes the h2 stream at exactly 30s (the
		# Day 16 carryover external curl saw CURLE_HTTP2_STREAM exit 92 at 30.2s).
		# `idle 24h` does NOT cover this because the connection is actively
		# writing between pings (so it's never "idle"). Raising `write 30s` →
		# `write 24h` matches `idle 24h` and unblocks the SSE multiplexer's
		# 30s-cadence `event: ping` heartbeat from h2 stream resets. Risk:
		# none material — non-SSE responses complete in milliseconds; a malicious
		# client tying up a write slot is constrained by the api-side rate limit
		# middleware (services/api/middleware.py `RateLimitMiddleware`, Day 17).
		# See Docs/decisions-log.md "Day 17 09:00" entry + implementation-guide.md
		# §8 DP register row DP-003.
		timeouts {
			read_body 10s
			read_header 5s
			write 24h
			idle 24h # long-lived SSE connections need this
		}
	}
}

# Operator basic-auth gate — shared by the frontend AND all /api/* traffic.
#
# SECURITY (2026-07-09, C1 night one): the api's session layer is still the
# Phase-0 stub (services/api/session.py), which injects a strong-auth
# operator session into every request in non-live-tagged environments. The
# VPS runs env=paper while managing REAL MONEY (C1 small-live), so before
# this gate the entire API — including risk-loosening POSTs like
# kill-switch resume — was publicly reachable on the apex. Until the real
# WebAuthn session middleware lands, this edge gate IS the auth boundary:
# every /api/* path except the public health probe requires these
# credentials. Internal consumers (discord_bot, webhook_pusher, workers)
# talk to api:8000 on the Docker network and never pass through Caddy;
# the watchdog push keeps its own IP-allowlisted handle.
#
# Password hash generated via:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<pw>'
# To rotate: regenerate the hash and replace the second token below.
(operator_basic_auth) {
	basic_auth {
		spratcapital2026! $2a$14$.tOJT3KwonivfSDdTeoZEe2bvYmFvxDg8uCv6SA.v9iQRt4lmdFTO
	}
}

# Apex domain. {$DOMAIN} is set in deploy/.env on the VPS (e.g. spratcapital.com).
{$DOMAIN} {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Day 24: 'unsafe-inline' added to script-src because Next.js 14 App Router
		# emits inline hydration bootstrap scripts (`__next_f.push(...)` chunks
		# inlined into <script> tags) that are required for client-side React to
		# attach. Without 'unsafe-inline', the page renders statically but is
		# non-interactive (no input handlers, no state, no navigation). Same
		# issue surfaced during the Day 24 operator ceremony at /setup.
		#
		# Phase 1 follow-up (deferred): switch to nonce-based CSP (Caddy injects
		# a per-request nonce; Next.js applies it to its inline scripts via
		# next.config.js `experimental.serverActions.nonce` or middleware).
		# Until then, 'unsafe-inline' for script-src is the standard Next.js
		# production workaround.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; connect-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'"
	}

	# Public health probe — the ONLY unauthenticated API path (runbook curls,
	# uptime checks). Matched before the gated /api/* handle below.
	handle /api/health {
		reverse_proxy api:8000
	}

	# Server-Sent Events — must not buffer; long read timeout for 24h replay window.
	# Gated: the browser re-sends the cached basic-auth credentials for
	# same-origin EventSource requests.
	handle /api/sse/events {
		import operator_basic_auth
		reverse_proxy api:8000 {
			flush_interval -1
			transport http {
				read_timeout 24h
			}
		}
	}

	# Watchdog push endpoint — IP-allowlisted to the Hetzner Nuremberg static IP.
	# WATCHDOG_IP is set in deploy/.env on the VPS (Day 4: 188.245.37.16).
	@watchdog {
		path /api/internal/watchdog
		remote_ip {$WATCHDOG_IP}
	}
	handle @watchdog {
		reverse_proxy api:8000
	}

	# All other API traffic — basic_auth-gated (see the snippet header for
	# why this is currently the ONLY auth boundary in front of real money).
	handle /api/* {
		import operator_basic_auth
		reverse_proxy api:8000
	}

	# Internal admin tools — only resolve when `--profile phase1` is active
	# (docker-compose.yml). Phase 0 Day 5 has no grafana/gitea upstream;
	# requests fall through to handle_errors below.
	handle_path /grafana/* {
		reverse_proxy grafana:3000
	}

	handle_path /gitea/* {
		reverse_proxy gitea:3000
	}

	# Maintenance fallback for 5xx (also covers Day-5 case where the Next.js
	# upstream below isn't running yet).
	handle_errors {
		@5xx expression `{http.error.status_code} >= 500`
		handle @5xx {
			respond "Service temporarily unavailable. Watchdog has been notified." 503
		}
	}

	# Default → Next.js frontend. Same operator gate as /api/* (2026-07-09:
	# the old "frontend only" stopgap became the full edge auth boundary —
	# see the snippet header at the top of this file).
	handle {
		import operator_basic_auth
		reverse_proxy nextjs:3000
	}
}

# www → apex redirect (for visitors typing www.{$DOMAIN}).
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# ----------------------------------------------------------------------------
# Live-money subdomain — per O1 (Docs/live-money-cutover-plan.md §10 step 6)
# live takes `live.{$DOMAIN}`; paper stays at the apex.
#
# Routes traffic to the LIVE compose project's api container. Live runs as a
# separate compose project (`trading-live`) on the SAME VPS — see
# docker-compose.live.yml.
#
# CROSS-PROJECT NETWORKING — deferred operator decision (resolves at cutover):
#
# Paper's Caddy (this container) lives on `trading_internal` network and can
# resolve `api:8000` to paper's api. To route this site block to LIVE's api,
# Caddy needs a path to reach the trading-live project's api container. Three
# options, picked at cutover ceremony:
#
#   (a) Shared external network. Operator runs once pre-cutover:
#         docker network create caddy_to_live
#       Both paper's caddy AND trading-live's api join `caddy_to_live`. Caddy
#       resolves `trading-live-api-1:8000` by docker service name.
#       Requires modifying paper's docker-compose.yml caddy block to join
#       this network — single-line addition, low-blast-radius.
#
#   (b) Host-port publish. trading-live's api publishes 8000 → host port
#       8001. Caddy reaches via `host.docker.internal:8001` (needs the
#       `extra_hosts: ['host.docker.internal:host-gateway']` directive on the
#       caddy service). Simpler but couples Caddy config to host networking.
#
#   (c) Separate Caddy per stack. trading-live runs its own Caddy on a
#       different host port pair (e.g., 81/444 → reverse-proxied at the
#       router or Hetzner Cloud LB). Cleanest isolation but operator must
#       manage two Caddy instances.
#
# Recommended default: (a). Codified as cutover-day decision; this Caddyfile
# block uses the (a)-style upstream name `trading-live-api-1` which is the
# docker default when `--project-name trading-live` + service name `api` +
# scale 1. If the operator picks (b) or (c), this block needs editing pre-
# `docker compose restart caddy`.
live.{$DOMAIN} {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Same Next.js `unsafe-inline` script-src tradeoff as the apex block;
		# nonce-based CSP migration is a shared Phase 1+ follow-up.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; connect-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'"
	}

	# SSE — must not buffer; long read timeout for the 24h replay window.
	handle /api/sse/events {
		reverse_proxy trading-live-api-1:8000 {
			flush_interval -1
			transport http {
				read_timeout 24h
			}
		}
	}

	# Watchdog push endpoint — IP-allowlisted to the Hetzner Nuremberg static
	# IP. The watchdog polls BOTH live + paper per cutover plan §9.
	@watchdog {
		path /api/internal/watchdog
		remote_ip {$WATCHDOG_IP}
	}
	handle @watchdog {
		reverse_proxy trading-live-api-1:8000
	}

	# All other API traffic
	handle /api/* {
		reverse_proxy trading-live-api-1:8000
	}

	# Maintenance fallback for 5xx.
	handle_errors {
		@5xx expression `{http.error.status_code} >= 500`
		handle @5xx {
			respond "Live service temporarily unavailable. Watchdog has been notified." 503
		}
	}

	# Default → live Next.js frontend (deferred; not yet in
	# docker-compose.live.yml). Until the live nextjs service ships, requests
	# to `/` fall through to handle_errors above. /api/* routes work standalone.
	#
	# Temporary "simple auth" gate mirrors paper. Re-decide pre-cutover
	# whether live should use the same basic_auth gate or rely solely on the
	# WebAuthn/TOTP ceremony at /login (which is now wired end-to-end per
	# Day 24 ceremony). Until decided, live carries the same gate as paper.
	#
	# Password hash regenerate via:
	#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<pw>'
	handle {
		basic_auth {
			spratcapital2026! $2a$14$.tOJT3KwonivfSDdTeoZEe2bvYmFvxDg8uCv6SA.v9iQRt4lmdFTO
		}
		reverse_proxy trading-live-nextjs-1:3000
	}
}
