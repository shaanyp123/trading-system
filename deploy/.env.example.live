# Template for `deploy/.env.live` on the VPS — live-money cutover stack.
# Copy to `.env.live` (gitignored) and fill in per environment.
# Anti-pattern A11: never commit a populated `.env*`. gitleaks blocks it on push.
#
# Brings up a SECOND compose project (`trading-live`) ALONGSIDE the existing
# paper project (`trading`). Paper continues uninterrupted; live runs in
# parallel with isolated networks + volumes + IBKR session.
#
# Operator command at cutover (per Docs/live-money-cutover-plan.md §10):
#   docker compose -p trading-live --env-file deploy/.env.live \
#       -f docker-compose.live.yml up -d
#
# See Docs/live-money-cutover-plan.md §10 + decisions-log 2026-05-27
# (afternoon) entry for the full cutover ceremony.

# GHCR image namespace (locked: shaanyp123)
GHCR_OWNER=shaanyp123

# Release SHA — set by deploy hook; defaults to `latest` for local up.
# Operator may pin to a specific SHA at cutover for reproducibility.
RELEASE_SHA=latest

# Audit env tag — matches `audit_log.env` CHECK constraint.
# One of: dev | paper | live-small | live-scale
# Cutover Day 1 = live-small per cutover plan §1 + §2 ($25k starting tier).
ENVIRONMENT=live-small

# Caddy auto-cert + apex domain. Per O1 (cutover plan §10 step 6) live
# takes the live subdomain; paper continues at the apex.
DOMAIN=live.spratcapital.com
ACME_EMAIL=shaanrpatel2@gmail.com

# Caddy IP allowlist for /api/internal/watchdog (Hetzner Nuremberg static IP).
WATCHDOG_IP=188.245.37.16

# Environment file used by sops_init at compose start.
# One of: dev.enc.yaml | paper.enc.yaml | live.enc.yaml
ENV_FILE=live.enc.yaml

# Path to age private key on the VPS (systemd LoadCredentialEncrypted exposes
# this). Live and paper share the age key (same VPS); each stack picks its
# own ENV_FILE from this shared decryption surface.
SOPS_AGE_KEY_FILE=/etc/credstore.encrypted/age_key

# Postgres superuser bootstrap for the live cluster — MUST be different from
# paper's `POSTGRES_SUPERUSER_PASSWORD` (live postgres is a SEPARATE container
# with its own data volume). Generate via `openssl rand -hex 32` on the live
# VPS pre-cutover. The app-level role passwords (app_service, app_owner) live
# in `secrets/live.enc.yaml`, NOT here.
POSTGRES_SUPERUSER_PASSWORD=<openssl-rand-hex-32-LIVE>

# Path on the live VPS where sops-decrypted secrets get written before mount
# into the live api container. Distinct from paper's secrets-decrypted/ dir
# so a paper-side sops accident can't bleed into live's runtime.
SECRETS_DIR=/opt/trading/secrets-decrypted-live

# Optional api log verbosity.
API_LOG_LEVEL=INFO

# IBKR TWS API port for the LIVE gateway socat. gnzsnz/ib-gateway publishes
# 4003 in live mode (TRADING_MODE=live) vs 4004 in paper mode. The api's
# services/api/config.py reads this via `API_IBKR_PORT` (default 4004 paper).
API_IBKR_PORT=4003

# IBKR live account number. Sourced from operator memory + cutover plan §10
# step 1. The api uses this as the `account` parameter on
# IbAsyncIbkrClient.connect() so order placement targets the right account
# even when the gateway has multiple accounts logged in.
API_IBKR_ACCOUNT=U25655583

# IBKR TWS API clientId for the LIVE order-placement worker. Default 1 per
# dev-guide §1.5 LOCKED. Each compose project has its OWN ib_gateway sidecar,
# so live's clientId=1 is fully isolated from paper's clientId=1 (different
# IBKR sessions, different gateway containers, different IBKR accounts).
# Override to 2-7 only if the live IBKR session has a wedged clientId=1.
# API_IBKR_CLIENT_ID=1


# IBKR Master Client ID for live. When set, the named clientId can cancel
# orders placed by any clientId on the live gateway session (per Mitigation A
# of the cross-clientId cancellation limitation; see Docs/decisions-log.md
# 2026-05-27 entry). Recommend setting to match API_IBKR_CLIENT_ID (1 or
# whatever the live worker is on). Requires
# `docker compose -p trading-live up -d --force-recreate ib_gateway` to
# take effect; outside the 20:55-22:35 UTC abort window. Validate via
#   python -m scripts.operator_tools.master_client_id_probe \
#     --master-client-id <value> --env live-small --allow-non-paper
# IBKR_MASTER_CLIENT_ID=1

# LEAN Local live-mode toggle. For the live stack this MUST be true (LEAN
# generates signals against the live universe; the api gates approvals).
# LEAN_LIVE_MODE=true

# IBKR Gateway login credentials. Sourced from sops `ibkr.live_username` +
# `ibkr.live_password` (DIFFERENT from paper). The compose file reads these
# into the ib_gateway container's TWS_USERID + TWS_PASSWORD env at boot.
# IB_GATEWAY_USERNAME=<from-sops>
# IB_GATEWAY_PASSWORD=<from-sops>

# Live IBKR Gateway trading mode. MUST be `live` for the live stack.
IB_GATEWAY_MODE=live

# Live IBKR Gateway VNC password (optional; only needed if operator wants
# to attach via VNC for debugging). Sourced from sops.
# IB_GATEWAY_VNC_PASSWORD=<from-sops>
