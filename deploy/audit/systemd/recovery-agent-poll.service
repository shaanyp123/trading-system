[Unit]
# Recovery agent — async_task_died poll + replay decisioning.
#
# Runs `scripts/operator_tools/recovery_agent_tick.sh paper` which:
#   1. Decrypts sops + builds DATABASE_URL (chmod 600 tmpfs file path)
#   2. Reads Discord #critical webhook URL from /etc/trading/critical-webhook.url
#   3. Invokes `python -m scripts.operator_tools.recovery_agent --env paper`
#      inside the api container. The agent polls the alerts table for
#      unhandled worker_failure events + audit-first emits
#      RECOVERY_ACTION_TAKEN + invokes replay_executions.py for
#      transient failures + UPDATEs alerts + POSTs to Discord #critical.
#   4. Always exits 0 (cron-friendly). Per-tick outcomes flow through
#      systemd journal + Discord (operator-visible).
#
# Independent of api's webhook_pusher by design — if api/webhook_pusher
# is down, the recovery agent's direct Postgres + Discord access still
# works. Closes the manual operator step from drill 5 (2026-05-18) +
# drill 7 (2026-05-18) where the operator hand-ran replay_executions.py
# to recover backend-blind fills.
#
# Why a dedicated systemd timer (not in-process api task):
#   * In-process tasks die when api dies — the very scenario this
#     agent is built to handle (OrderPlacementWorker death).
#   * VPS systemd is the correct surface for safety-critical 24/7
#     monitoring per Docs/agentic-patterns.md Pattern 6.
#   * Matches the existing verify-chain-daily.timer pattern (landed
#     2026-05-26 in the same week).
#
# See deploy/audit/README.md for the install ceremony.

Description=Recovery agent — async_task_died poll + replay decisioning
Documentation=https://github.com/shaanyp123/trading-system/blob/main/deploy/audit/README.md
After=docker.service
Requires=docker.service
# Alert on failure — posts P1 to Discord #alerts (closes the silent-failure
# gap from PR #321). See deploy/audit/systemd/notify-unit-failure@.service.
# The notifier's per-unit cooldown caps this 60s-cadence unit at one #alerts
# post/hour if it ever enters a sustained failure loop.
OnFailure=notify-unit-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/trading
# Runs as root — matches verify-chain-daily.service + lean-local-daily-restart.service.
# Required because /opt/trading/deploy/.env is chmod 600 root:root (carries
# GHCR_OWNER + other deploy interpolation values for `docker compose exec`).
# The webhook URL file at /etc/trading/critical-webhook.url is chmod 600
# trading:trading but root can read regardless.
ExecStart=/opt/trading/scripts/operator_tools/recovery_agent_tick.sh paper
# Single-shot timer; runaway restart impossible. 120s gives the recovery
# agent enough time to handle worst case (multiple alerts × replay
# subprocess timeout) without leaving the timer cadence behind.
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
