[Unit]
# Fires recovery-agent-poll.service every 60s after a 2-min boot delay.
#
# Why 60s cadence:
#   * Matches the operator-brief recovery-latency budget ("agent
#     detects within ~60s via systemd timer poll").
#   * The async_task_monitor probes every 30s (default
#     ``async_task_monitor_interval_seconds``); a 60s recovery cadence
#     means death → alerts INSERT → recovery action ≤ 90s wall-clock
#     from worker exit to Discord post.
#   * Per-tick query is indexed on (category, acknowledged) — reads
#     at most ~10 rows in the 5-min window; subprocess invocation
#     gated by classification = invoke_replay. CPU/IO cost: negligible.
#
# Why OnBootSec=2min (not 0s):
#   * Avoids the cold-start fire while the api container is still
#     spinning up post-VPS-reboot. The api's lifespan needs ~30-60s
#     to initialize the asyncpg pool + spawn workers; firing the
#     recovery agent against an unready api gives a noisy DB error.
#   * The 2-min budget is generous; if the api hasn't booted by then
#     there's a real problem worth surfacing via the agent's DB-init-
#     failed path.
#
# Why OnUnitActiveSec=60s (not OnCalendar=*-*-* *:*:00):
#   * Monotonic cadence — if a tick takes 90s (replay subprocess +
#     Postgres serialization retries), the next tick fires 60s after
#     completion, not 60s after start. Avoids stacking ticks.
#   * AccuracySec=10s relaxes the boundary so systemd can coalesce
#     this timer with others (reducing CPU wake-ups).

Description=Recovery agent — every 60s poll of alerts.worker_failure
Documentation=https://github.com/shaanyp123/trading-system/blob/main/deploy/audit/README.md

[Timer]
OnBootSec=2min
OnUnitActiveSec=60s
Unit=recovery-agent-poll.service
AccuracySec=10s
Persistent=false

[Install]
WantedBy=timers.target
