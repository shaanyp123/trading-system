[Unit]
# Restart the lean_local container daily so its
# SubscriptionDataReaderHistoryProvider re-reads the lean_data volume
# (the api's BarSyncWorker writes fresh per-day daily-zip + universe
# files every day at 17:00 ET / 21:00 UTC, but LEAN caches the data
# layer at boot — without a daily restart the cache stays stale).
#
# Symptom this prevents: lean_local logs
#   v1_history_unavailable session_date=YYYY-MM-DD failed_markets=[…7 futures…]
#   v1_signals_generated session_date=YYYY-MM-DD signals_emitted_count=0
# even though bar_sync wrote all 11 markets cleanly hours earlier (the
# stat() in the lean_local container shows the fresh files, but LEAN's
# in-process data layer doesn't re-scan).
#
# See Docs/decisions-log.md 2026-05-21 entry "lean_local data-layer
# cache fix: daily restart timer" for the full root-cause analysis.

Description=Restart lean_local to refresh its on-boot data layer cache (post-bar_sync daily zips)
Documentation=https://github.com/shaanyp123/trading-system/blob/main/deploy/lean_local/systemd/README.md
After=docker.service
Requires=docker.service
# Alert on failure — posts P1 to Discord #alerts (closes the silent-failure
# gap from PR #321). See deploy/audit/systemd/notify-unit-failure@.service.
OnFailure=notify-unit-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/trading
# `docker compose restart` is graceful: SIGTERM → 10s grace → SIGKILL.
# LEAN has no persistent state in-container (the algo state lives in
# the lean_data volume mount, which is the read-only data layer; LEAN
# itself is stateless across restarts in this architecture).
ExecStart=/usr/bin/docker compose --env-file /opt/trading/deploy/.env restart lean_local
# Avoid runaway restarts if the docker daemon is unhealthy. The timer
# fires once per day; if a restart fails, the next attempt is 24h away.
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
