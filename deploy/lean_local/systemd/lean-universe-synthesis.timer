[Unit]
Description=Daily synthesis of LEAN futures universe files (30 min before cycle)
Documentation=file:///etc/systemd/system/lean-universe-synthesis.service
Requires=lean-universe-synthesis.service

[Timer]
# 21:00 UTC daily — 30 min before LEAN's on_daily_signal_cycle at 21:30 UTC.
# Persistent=true ensures catch-up if VPS was down at scheduled time.
OnCalendar=*-*-* 21:00:00 UTC
Persistent=true
AccuracySec=1min
Unit=lean-universe-synthesis.service

[Install]
WantedBy=timers.target
