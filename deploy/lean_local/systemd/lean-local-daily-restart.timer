[Unit]
# Fires the lean-local-daily-restart.service at 21:10 UTC daily.
#
# Why 21:10 UTC:
#   * bar_sync worker fires at 17:00 ET (21:00 UTC) and completes in
#     ~8-90 seconds (observed 2026-05-21: 8.75s clean / 26-65s with OI
#     timeouts). 21:10 UTC = 10 minutes of margin past the upper end.
#   * LEAN signal cycle fires at 17:30 ET (21:30 UTC). 21:10 UTC leaves
#     ~20 minutes for lean_local to boot + initialize the algorithm
#     before the cycle deadline (~30s container boot + ~2s
#     v1_strategy initialized is typical).
#   * EOD reconciliation fires at 18:30 ET (22:30 UTC) — well after.
#
# Persistent=true: if the VPS was down at the scheduled time, fire
# the service on next boot. This handles weekend / maintenance windows
# without needing manual catch-up.

Description=Daily lean_local restart at 21:10 UTC (between bar_sync 21:00 UTC + LEAN cycle 21:30 UTC)
Documentation=https://github.com/shaanyp123/trading-system/blob/main/deploy/lean_local/systemd/README.md

[Timer]
OnCalendar=*-*-* 21:10:00
Persistent=true
Unit=lean-local-daily-restart.service

[Install]
WantedBy=timers.target
