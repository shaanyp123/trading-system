# apps/web/.env.example — copy to `.env.local` for local dev; never commit
# secrets. Domain placeholder per dev-guide §1.5: `<your-domain>` is the
# operator's registered apex (substituted at deploy time). Production
# substitution lives in `deploy/.env` on the VPS.

# Base URL for client + server fetches against the FastAPI backend.
# - Local dev:  http://localhost:8000  (when `make ci` or services/api/entrypoint.py is running)
# - Docker:     http://api:8000        (resolved over the trading_internal network)
# - Production: https://<your-domain>  (set by deploy/.env on the VPS)
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Phase gate (0=scaffold, 1=phase1, 2=phase2, 3=phase3).
# Routes whose `available_from` in src/lib/routes.config.ts exceeds this
# value return 404 via Next middleware (see dev-guide §8.1).
NEXT_PUBLIC_PHASE=0
